<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HazzMusicBingo</AssemblyName>
    <RootNamespace>HazzMusicBingo</RootNamespace>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Product>Hazz Music Bingo</Product>
    <Description>Music bingo host, card designer, printing and winner verification for Windows.</Description>
    <ApplicationIcon>Assets/HazzMusicBingo.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HazzMusicBingo.Regression" />
    <Resource Include="Assets/HazzMusicBingo.png" />
    <Resource Include="Assets/HazzMusicBingo.ico" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!-- Keep the LGPL tag reader replaceable in published packages. -->
  <Target Name="KeepTagReaderExternal" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle">
    <ItemGroup>
      <ExternalTagReader Include="@(FilesToBundle)" Condition="'%(Filename)%(Extension)' == 'TagLibSharp.dll'" />
      <FilesToBundle Remove="@(ExternalTagReader)" />
    </ItemGroup>
    <Copy SourceFiles="@(ExternalTagReader)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
