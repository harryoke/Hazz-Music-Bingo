<Window x:Class="HazzMusicBingo.Views.MusicHealthWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Check music &amp; locate missing files" Width="1050" Height="620" MinWidth="800" MinHeight="500" WindowStartupLocation="CenterOwner">
 <Grid Margin="20" Background="#F7F9FC"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="MUSIC CHECK" FontSize="26" FontWeight="Bold"/><TextBlock Text="Checks file availability and the last scan result. Relink only to the same song: all saved cards and games keep their song identity." TextWrapping="Wrap" Margin="0,8,0,12"/></StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"><CheckBox x:Name="GameOnlyBox" Content="Current game only" VerticalAlignment="Center"/><Button x:Name="RefreshButton" Content="Check / Refresh" Click="Refresh_Click"/><TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0"/></StackPanel>
  <DataGrid x:Name="IssuesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Song" Binding="{Binding Title}" Width="180"/><DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="130"/><DataGridTextColumn Header="Problem" Binding="{Binding Problem}" Width="230"/><DataGridTextColumn Header="Saved file path" Binding="{Binding FilePath}" Width="*"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="3"><TextBlock Text="Availability does not guarantee a file will still decode or an audio device will work. Rescan changed files. Relinking updates this computer's library; save the game again to update portable game files." TextWrapping="Wrap" Margin="0,12,0,6"/><Button x:Name="RelinkButton" Content="Locate selected song…" Click="Relink_Click" HorizontalAlignment="Right"/></StackPanel>
 </Grid>
</Window>
