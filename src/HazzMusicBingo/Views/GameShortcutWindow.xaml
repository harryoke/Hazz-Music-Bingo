<Window x:Class="HazzMusicBingo.Views.GameShortcutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Set up game button" Width="620" Height="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#EEF2F7">
 <StackPanel Margin="22" Background="#EEF2F7">
  <TextBlock Text="GAME BUTTON" FontSize="23" FontWeight="Bold"/>
  <TextBlock Text="Button label" Margin="0,14,0,4"/>
  <TextBox x:Name="LabelBox" MaxLength="32"/>
  <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Choose colour…" Click="Color_Click"/><TextBox x:Name="ColorBox" Text="#4F46E5" VerticalContentAlignment="Center"/></DockPanel>
  <TextBlock Text="Saved game (.hmbgame)" Margin="0,12,0,4"/>
  <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/><TextBox x:Name="FileBox" VerticalContentAlignment="Center"/></DockPanel>
  <WrapPanel Margin="0,12,0,0"><Button Content="Audience theme…" Click="Theme_Click"/><Button Content="Use current audience style" Click="Current_Click"/></WrapPanel>
  <TextBlock x:Name="ThemeText" TextWrapping="Wrap" Margin="4"/>
  <TextBlock Text="The button keeps its own copy of the save and background image. Clicking it resumes its game progress; switching never resets songs." TextWrapping="Wrap" Margin="4,10"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button Content="Save button" Click="Save_Click" IsDefault="True"/></StackPanel>
 </StackPanel>
</Window>
