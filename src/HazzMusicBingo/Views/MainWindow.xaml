<Window x:Class="HazzMusicBingo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hazz Music Bingo v.0.1"
        Width="1380"
        Height="820"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#E7ECF3"/>
            <Setter Property="Foreground" Value="#202936"/>
            <Setter Property="BorderBrush" Value="#CBD4E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
        </Style>

        <Style x:Key="PlayButton"
               TargetType="Button"
               BasedOn="{StaticResource AccentButton}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="18,13"/>
        </Style>

        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC3545"/>
        </Style>

        <Style x:Key="Panel"
               TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="SectionHeading"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#172033"
                Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HAZZ MUSIC BINGO"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="Bold"/>
                    <TextBlock Text="Windows Host Console • v.0.1"
                               Foreground="#9EABC1"
                               FontSize="13"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#26334B"
                        CornerRadius="18"
                        Padding="16,7"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="GameStatusText"
                               Text="No active game"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="305"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="335"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: library and game -->
            <Border Grid.Column="0"
                    Style="{StaticResource Panel}"
                    Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MUSIC LIBRARY"
                                   Style="{StaticResource SectionHeading}"/>

                        <Border Background="#F4F6FA"
                                CornerRadius="8"
                                Padding="13"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="LibraryCountText"
                                           Text="Songs indexed: 0"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="PlayedCountText"
                                           Text="Songs played: 0 / 60"
                                           FontSize="15"
                                           Foreground="#667085"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="SCAN MUSIC FOLDER"
                                Click="ScanFolder_Click"/>

                        <Button Content="CHECK MUSIC / LOCATE FILES" Click="CheckMusic_Click"/>
                        <TextBlock x:Name="MusicHealthText" TextWrapping="Wrap" Margin="4,4,4,8"/>
                        <ProgressBar x:Name="ScanProgressBar"
                                     Height="16"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     Margin="4,8,4,4"/>

                        <TextBlock x:Name="ScanStatusText"
                                   Text=""
                                   TextWrapping="Wrap"
                                   Foreground="#667085"
                                   MinHeight="48"
                                   Margin="4,2,4,12"/>

                        <Separator Margin="0,4,0,14"/>

                        <TextBlock Text="GAME"
                                   Style="{StaticResource SectionHeading}"/>

                        <Button x:Name="GenerateGameButton"
                                Content="GENERATE 60-SONG GAME"
                                Style="{StaticResource AccentButton}"
                                Click="GenerateGame_Click"/>

                        <WrapPanel Margin="0,3,0,0">
                            <Button x:Name="SaveGameButton"
                                    Content="SAVE GAME..."
                                    Width="128"
                                    IsEnabled="False"
                                    Click="SaveGame_Click"/>
                            <Button Content="LOAD GAME..."
                                    Width="128"
                                    Click="LoadGame_Click"/>
                        </WrapPanel>

                        <Button Content="GAME HISTORY / RECOVERY" Click="GameHistory_Click"/>
                        <Button x:Name="ResetGameButton"
                                Content="RESET GAME TO 0"
                                IsEnabled="False"
                                Click="ResetGame_Click"/>

                        <Button x:Name="NewGameButton"
                                Content="NEW / CLOSE GAME"
                                IsEnabled="False"
                                Click="NewGame_Click"/>

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#7A8495"
                                   FontSize="12"
                                   Margin="4,10,4,0"
                                   Text="Saved game files preserve the exact 60-song pool, played progress and generated cards. Playback order is newly randomized every time a saved game is loaded."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTRE: playback -->
            <Border Grid.Column="1"
                    Style="{StaticResource Panel}"
                    Margin="8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock Text="HOST PLAYBACK"
                                   Style="{StaticResource SectionHeading}"/>
                        <Border DockPanel.Dock="Right"
                                Background="#F0F2F6"
                                CornerRadius="8"
                                Padding="10,5">
                            <TextBlock x:Name="PlaybackText"
                                       Text="Ready"
                                       Foreground="#667085"
                                       FontSize="13"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Background="#F7F9FC"
                            CornerRadius="12"
                            Padding="26"
                            Margin="0,12,0,16">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="650">
                            <TextBlock Text="CURRENT SONG"
                                       Foreground="#8A94A6"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>
                            <TextBlock x:Name="CurrentTitleText"
                                       Text="Ready"
                                       FontSize="48"
                                       FontWeight="Bold"
                                       Foreground="#202936"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="CurrentArtistText"
                                       Text=""
                                       FontSize="27"
                                       Foreground="#667085"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayNextButton"
                                Content="▶  PLAY NEXT SONG"
                                Style="{StaticResource PlayButton}"
                                IsEnabled="False"
                                Click="PlayNext_Click"/>

                        <Button x:Name="StopButton"
                                Grid.Column="1"
                                Content="■  STOP"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="False"
                                Click="StopMusic_Click"/>
                    </Grid>

                    <UniformGrid Grid.Row="3"
                                 Columns="3"
                                 Margin="0,5,0,0">
                        <Button x:Name="RepeatButton"
                                Content="↻ REPEAT LAST"
                                IsEnabled="False"
                                Click="Repeat_Click"/>
                        <Button x:Name="PlayedSongsButton"
                                Content="CHECK PLAYED SONGS"
                                IsEnabled="False"
                                Click="PlayedSongs_Click"/>
                        <Button Content="SHOW AUDIENCE"
                                Click="ShowAudience_Click"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- RIGHT: design and print -->
            <Border Grid.Column="2"
                    Style="{StaticResource Panel}"
                    Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="DESIGN &amp; OUTPUT"
                                   Style="{StaticResource SectionHeading}"/>

                        <Button Content="BINGO CARD DESIGN"
                                Click="CardDesign_Click"/>
                        <Button Content="AUDIENCE SCREEN DESIGN"
                                Click="AudienceDesign_Click"/>

                        <Button x:Name="WinnerButton" Content="CHECK WINNING CARD" Click="Winner_Click" IsEnabled="False"/>
                        <Button x:Name="PrintCardsButton"
                                Content="PREVIEW / PRINT CARDS"
                                Style="{StaticResource AccentButton}"
                                IsEnabled="False"
                                Click="PrintCards_Click"/>

                        <Separator Margin="0,13,0,14"/>

                        <TextBlock Text="PLAYBACK"
                                   Style="{StaticResource SectionHeading}"/>

                        <Border Background="#F4F6FA"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Clip length"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="ClipSecondsCombo"
                                          SelectedIndex="3"
                                          FontSize="15"
                                          Height="34">
                                    <ComboBoxItem Content="10 seconds" Tag="10"/>
                                    <ComboBoxItem Content="15 seconds" Tag="15"/>
                                    <ComboBoxItem Content="20 seconds" Tag="20"/>
                                    <ComboBoxItem Content="25 seconds" Tag="25"/>
                                    <ComboBoxItem Content="30 seconds" Tag="30"/>
                                    <ComboBoxItem Content="35 seconds" Tag="35"/>
                                    <ComboBoxItem Content="40 seconds" Tag="40"/>
                                    <ComboBoxItem Content="45 seconds" Tag="45"/>
                                    <ComboBoxItem Content="60 seconds" Tag="60"/>
                                </ComboBox>
                                <TextBlock Text="Clips automatically fade out over the final 2 seconds."
                                           Foreground="#7A8495"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,15,0,14"/>

                        <TextBlock Text="CARD PRINTING"
                                   Style="{StaticResource SectionHeading}"/>

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#667085"
                                   Text="Preview 1, 2 or 4 cards per page on A4 or Letter. Choose a card range, margins and ink saver. Print to paper or Microsoft Print to PDF. Designs can be saved as reusable presets."/>

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#7A8495"
                                   FontSize="12"
                                   Margin="0,12,0,0"
                                   Text="The exact printed area still depends on the physical printer's non-printable margins unless borderless A4 is supported."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#DDE4ED"
                Padding="12,0">
            <TextBlock x:Name="FooterText"
                       Text="Database: not initialised"
                       Foreground="#5A6575"
                       VerticalAlignment="Center"
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>
