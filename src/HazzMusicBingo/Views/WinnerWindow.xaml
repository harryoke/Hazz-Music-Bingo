<Window x:Class="HazzMusicBingo.Views.WinnerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Check a winning card" Width="1050" Height="780" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Background="#EEF2F7" Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="GameLabel" FontSize="24" FontWeight="Bold"/><TextBlock Text="Match the game code on the printed card before checking. Played songs are shown in green. No free centre square." Margin="0,8,0,14" TextWrapping="Wrap"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Card number" VerticalAlignment="Center"/><TextBox x:Name="CardBox" Text="1" Width="60" Margin="8,0,14,0" VerticalContentAlignment="Center"/><ComboBox x:Name="PatternBox" SelectedIndex="0" Width="240" VerticalContentAlignment="Center"><ComboBoxItem Content="Any row, column or diagonal"/><ComboBoxItem Content="Four corners"/><ComboBoxItem Content="Full house"/></ComboBox><Button Content="Check / Refresh" Click="Check_Click"/></WrapPanel>
  <UniformGrid x:Name="Squares" Grid.Row="2" Rows="5" Columns="5"/>
  <TextBlock x:Name="ResultText" Grid.Row="3" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,14,0,0"/>
 </Grid>
</Window>
