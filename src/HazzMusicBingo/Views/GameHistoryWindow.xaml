<Window x:Class="HazzMusicBingo.Views.GameHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Game history &amp; recovery" Width="1000" Height="620" MinWidth="800" MinHeight="480" WindowStartupLocation="CenterOwner">
 <Grid Margin="20" Background="#F7F9FC"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="GAME HISTORY &amp; RECOVERY" FontSize="26" FontWeight="Bold"/><TextBlock Text="Reopen a previous game with its exact cards, played progress and existing playback order. The current game is closed but remains in this list." TextWrapping="Wrap" Margin="0,8,0,16"/></StackPanel>
  <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Game code" Binding="{Binding SessionCode}" Width="170"/><DataGridTextColumn Header="Created (local time)" Binding="{Binding CreatedLocal}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Played" Binding="{Binding Progress}" Width="100"/><DataGridTextColumn Header="Saved cards" Binding="{Binding Cards}" Width="110"/></DataGrid.Columns></DataGrid>
  <StackPanel Grid.Row="2"><TextBlock x:Name="StatusText" Margin="0,10,0,6" TextWrapping="Wrap"/><WrapPanel HorizontalAlignment="Right"><Button x:Name="BackupButton" Content="Back up database…" Click="Backup_Click"/><Button Content="Cancel" IsCancel="True"/><Button x:Name="RecoverButton" Content="Reopen selected game" Click="Recover_Click" FontWeight="Bold"/></WrapPanel></StackPanel>
 </Grid>
</Window>
