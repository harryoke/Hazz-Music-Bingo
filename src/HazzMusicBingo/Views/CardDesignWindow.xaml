<Window x:Class="HazzMusicBingo.Views.CardDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HazzMusicBingo.Controls"
        Title="Bingo Card Design"
        Width="1120"
        Height="760"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#EEF1F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <TextBlock Text="BINGO CARD DESIGN"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Quick theme"/>
                <ComboBox x:Name="ThemeBox" SelectedIndex="0" Margin="0,4,0,8">
                    <ComboBoxItem Content="Classic — clean white"/>
                    <ComboBoxItem Content="Midnight — navy and gold"/>
                    <ComboBoxItem Content="Festival — violet and blush"/>
                    <ComboBoxItem Content="Easy read — high contrast"/>
                </ComboBox>
                <Button Content="Apply theme" Click="ApplyTheme_Click"/>
                <TextBlock Text="Card title"/>
                <TextBox x:Name="TitleBox"
                         Margin="0,4,0,12"
                         Padding="7"
                         TextChanged="DesignChanged"/>

                <TextBlock Text="Header / subtitle"/>
                <TextBox x:Name="HeaderBox"
                         Margin="0,4,0,12"
                         Padding="7"
                         TextChanged="DesignChanged"/>

                <TextBlock Text="Font"/>
                <ComboBox x:Name="FontBox"
                          Margin="0,4,0,12"
                          Height="34"
                          SelectionChanged="DesignChanged"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Title size"/>
                        <TextBox x:Name="TitleSizeBox"
                                 Margin="0,4,0,0"
                                 Padding="6"
                                 TextChanged="DesignChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="3,0,3,0">
                        <TextBlock Text="Header size"/>
                        <TextBox x:Name="HeaderSizeBox"
                                 Margin="0,4,0,0"
                                 Padding="6"
                                 TextChanged="DesignChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                        <TextBlock Text="Song size"/>
                        <TextBox x:Name="CellSizeBox"
                                 Margin="0,4,0,0"
                                 Padding="6"
                                 TextChanged="DesignChanged"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ShowBingoLettersBox"
                          Content="Show B I N G O column letters"
                          Margin="0,2,0,8"
                          Checked="DesignChanged"
                          Unchecked="DesignChanged"/>

                <CheckBox x:Name="ShowArtistBox"
                          Content="Show artist as well as song title"
                          Margin="0,2,0,8"
                          Checked="DesignChanged"
                          Unchecked="DesignChanged"/>

                <CheckBox x:Name="BoldSongsBox"
                          Content="Bold song text"
                          Margin="0,2,0,8"
                          Checked="DesignChanged"
                          Unchecked="DesignChanged"/>

                <CheckBox x:Name="OutlineTextBox"
                          Content="Use text outline / stroke"
                          Margin="0,2,0,8"
                          Checked="DesignChanged"
                          Unchecked="DesignChanged"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="OutlineColourButton"
                            Grid.Column="0"
                            Content="Outline Colour"
                            Click="OutlineColour_Click"/>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Outline width (px)"/>
                        <TextBox x:Name="OutlineWidthBox"
                                 Margin="0,4,0,0"
                                 Padding="6"
                                 Text="2"
                                 TextChanged="DesignChanged"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,4,0,14"/>

                <TextBlock Text="COLOURS"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <UniformGrid Columns="2">
                    <Button x:Name="TextColourButton"
                            Content="Song Text Colour"
                            Click="TextColour_Click"/>
                    <Button x:Name="TitleColourButton"
                            Content="Title Colour"
                            Click="TitleColour_Click"/>
                    <Button x:Name="PageColourButton"
                            Content="Page Background"
                            Click="PageColour_Click"/>
                    <Button x:Name="CellColourButton"
                            Content="Square Background"
                            Click="CellColour_Click"/>
                    <Button x:Name="GridColourButton"
                            Content="Grid Line Colour"
                            Click="GridColour_Click"/>
                </UniformGrid>

                <TextBlock Text="Square background opacity"
                           Margin="0,12,0,4"/>
                <Slider x:Name="CellOpacitySlider"
                        Minimum="0.15"
                        Maximum="1"
                        ValueChanged="DesignChanged"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="False"/>

                <Separator Margin="0,16,0,14"/>

                <TextBlock Text="BACKGROUND DESIGN"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Optional JPG / PNG background image"/>
                <TextBox x:Name="BackgroundImageBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Height="48"
                         Margin="0,4,0,6"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Choose Image..."
                            Click="ChooseBackground_Click"/>
                    <Button Content="Clear Image"
                            Click="ClearBackground_Click"/>
                </StackPanel>

                <TextBlock Text="Background image opacity"
                           Margin="0,10,0,4"/>
                <Slider x:Name="ImageOpacitySlider"
                        Minimum="0.05"
                        Maximum="1"
                        ValueChanged="DesignChanged"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="False"/>

                <Separator Margin="0,16,0,14"/>

                <TextBlock Text="Footer / player instructions"/>
                <TextBox x:Name="FooterBox" Margin="0,4,0,12" TextChanged="DesignChanged"/>
                <TextBlock Text="Grid line width (0.25–4)"/>
                <TextBox x:Name="GridWidthBox" Margin="0,4,0,12" TextChanged="DesignChanged"/>
                <TextBlock Text="Square padding (2–16)"/>
                <TextBox x:Name="PaddingBox" Margin="0,4,0,12" TextChanged="DesignChanged"/>
                <CheckBox x:Name="AlternateRowsBox" Content="Alternate row shading" Margin="0,4,0,10" Checked="DesignChanged" Unchecked="DesignChanged"/>
                <CheckBox x:Name="LeftAlignBox" Content="Left-align song labels" Margin="0,4,0,14" Checked="DesignChanged" Unchecked="DesignChanged"/>
                <TextBlock Text="Preview and printing use the same layout. Every card includes its game code and card number." TextWrapping="Wrap" Margin="0,0,0,14"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Load Design..."
                            Width="120"
                            Click="LoadDesignFile_Click"/>
                    <Button Content="Save As..."
                            Width="110"
                            Click="SaveDesignFile_Click"/>
                    <Button Content="Reset Default"
                            Width="120"
                            Click="Reset_Click"/>
                    <Button Content="Cancel"
                            Width="100"
                            Click="Cancel_Click"/>
                    <Button Content="Use Design"
                            Width="120"
                            FontWeight="Bold"
                            Click="Save_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1"
                Margin="10,18,18,18"
                Background="#D5DAE2"
                CornerRadius="10"
                Padding="22">
            <Viewbox Stretch="Uniform">
                <ContentControl x:Name="CardPreview"/>
            </Viewbox>
        </Border>
    </Grid>
</Window>
