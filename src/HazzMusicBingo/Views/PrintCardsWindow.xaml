<Window x:Class="HazzMusicBingo.Views.PrintCardsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Print cards &amp; PDF" Width="1100" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
 <Grid Background="#EEF2F7" Margin="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,16,0">
   <TextBlock Text="PRINT CARDS" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
   <TextBlock x:Name="GameLabel" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <TextBlock Text="First card number"/><TextBox x:Name="FirstBox" Text="1" Margin="0,4,0,10"/>
   <TextBlock Text="Last card number"/><TextBox x:Name="LastBox" Text="20" Margin="0,4,0,10"/>
   <TextBlock Text="Cards per sheet"/><ComboBox x:Name="PerPageBox" SelectedIndex="0" Margin="0,4,0,10"><ComboBoxItem Content="1 — largest text"/><ComboBoxItem Content="2"/><ComboBoxItem Content="4 — compact"/></ComboBox>
   <TextBlock Text="Paper"/><ComboBox x:Name="PaperBox" SelectedIndex="0" Margin="0,4,0,10"><ComboBoxItem Content="A4"/><ComboBoxItem Content="US Letter"/></ComboBox>
   <TextBlock Text="Orientation"/><ComboBox x:Name="OrientationBox" SelectedIndex="0" Margin="0,4,0,10"><ComboBoxItem Content="Portrait"/><ComboBoxItem Content="Landscape"/></ComboBox>
   <TextBlock Text="Page margin (5–30 mm)"/><TextBox x:Name="MarginBox" Text="10" Margin="0,4,0,10"/>
   <CheckBox x:Name="InkSaverBox" Content="Ink saver (black on white)" Margin="0,4,0,12"/>
   <Button Content="Update preview" Click="Preview_Click"/>
   <Button Content="Print / Save PDF…" Click="Print_Click" FontWeight="Bold"/>
   <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,12,0,12"/>
   <TextBlock Text="To create a PDF, select Microsoft Print to PDF in the printer dialog. Copies and page range are selected there. Pages are fitted to the selected printer's printable area." TextWrapping="Wrap"/>
   <TextBlock Text="Four cards per sheet produces smaller text. Print one sample before a full run." TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer>
  <DocumentViewer x:Name="Preview" Grid.Column="1"/>
 </Grid>
</Window>
