<Window x:Class="HazzMusicBingo.Views.AudienceDesignWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Audience Screen Design" Width="1120" Height="760" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Background="#EEF1F5"><Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
 <TextBlock Text="AUDIENCE SCREEN DESIGN" FontSize="24" FontWeight="Bold" Margin="0,0,0,14"/>
 <TextBlock Text="Choose which text to style" FontWeight="Bold"/>
 <ComboBox x:Name="ElementBox" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="ElementChanged" Height="34" Margin="0,6,0,12"/>
 <TextBlock Text="Font"/>
 <ComboBox x:Name="ElementFontBox" SelectionChanged="ElementStyleChanged" Height="34" Margin="0,4,0,8"/>
 <WrapPanel><TextBlock Text="Size (12-140)" VerticalAlignment="Center"/><TextBox x:Name="ElementSizeBox" Width="65" Margin="8,0" TextChanged="ElementStyleChanged"/><Button x:Name="ElementColourButton" Content="Text colour..." Click="ElementColour_Click"/></WrapPanel>
 <WrapPanel Margin="0,8"><CheckBox x:Name="ElementBoldBox" Content="Bold" Margin="0,0,18,0" Checked="ElementStyleChanged" Unchecked="ElementStyleChanged"/><CheckBox x:Name="ElementItalicBox" Content="Italic" Checked="ElementStyleChanged" Unchecked="ElementStyleChanged"/></WrapPanel>
 <CheckBox x:Name="ElementOutlineBox" Content="Outline this text" Checked="ElementStyleChanged" Unchecked="ElementStyleChanged"/>
 <WrapPanel Margin="0,8"><Button x:Name="ElementOutlineColourButton" Content="Outline colour..." Click="ElementOutlineColour_Click"/><TextBlock Text="Width (0-12)" VerticalAlignment="Center" Margin="8,0"/><TextBox x:Name="ElementOutlineWidthBox" Width="55" TextChanged="ElementStyleChanged"/></WrapPanel>
 <TextBlock Text="Each selection keeps its own style. The preview shows the selected screen. Large text may need a smaller size to fit your display." TextWrapping="Wrap" Foreground="#53647A" Margin="0,4,0,10"/>
 <Separator/>
 <TextBlock Text="Now playing heading" Margin="0,10,0,4"/><TextBox x:Name="HeaderBox" TextChanged="DesignChanged" Padding="6"/>
 <TextBlock Text="Ready message" Margin="0,8,0,4"/><TextBox x:Name="ReadyBox" TextChanged="DesignChanged" Padding="6"/>
 <TextBlock Text="Played songs heading" Margin="0,8,0,4"/><TextBox x:Name="PlayedHeaderBox" TextChanged="DesignChanged" Padding="6"/>
 <CheckBox x:Name="ShowArtistBox" Content="Show artists" Margin="0,10" Checked="DesignChanged" Unchecked="DesignChanged"/>
 <Button x:Name="BackgroundColourButton" Content="Background colour..." Click="BackgroundColour_Click"/>
 <TextBlock Text="BACKGROUND IMAGE" FontWeight="Bold" Margin="0,14,0,6"/>
 <TextBox x:Name="BackgroundImageBox" IsReadOnly="True" TextWrapping="Wrap"/>
 <WrapPanel><Button Content="Choose image..." Click="ChooseBackground_Click"/><Button Content="Clear image" Click="ClearBackground_Click"/></WrapPanel>
 <TextBlock Text="Image opacity" Margin="0,8,0,4"/><Slider x:Name="ImageOpacitySlider" Minimum="0" Maximum="1" ValueChanged="DesignChanged"/>
 <WrapPanel Margin="0,14,0,0"><Button Content="Load design..." Click="LoadDesignFile_Click"/><Button Content="Save as..." Click="SaveDesignFile_Click"/><Button Content="Reset defaults" Click="Reset_Click"/></WrapPanel>
 <WrapPanel HorizontalAlignment="Right" Margin="0,8"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Use design" FontWeight="Bold" Click="Save_Click"/></WrapPanel>
 </StackPanel></ScrollViewer>
 <Border Grid.Column="1" Margin="12,18,18,18" Background="#D5DAE2" Padding="14" CornerRadius="10"><Viewbox Stretch="Uniform"><ContentControl x:Name="AudiencePreview" Width="1280" Height="720"/></Viewbox></Border>
 </Grid>
</Window>