<Window x:Class="HazzMusicBingo.Views.AudienceDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HazzMusicBingo.Controls"
        Title="Audience Screen Design"
        Width="1120"
        Height="760"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#EEF1F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <TextBlock Text="AUDIENCE SCREEN DESIGN"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,0,0,18"/>

                <TextBlock Text="WINNING RULE / WIN ANNOUNCEMENT" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Styles ‘WE ARE PLAYING FOR…’ and ‘… WON!’ independently of song text." TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Message font"/>
                <ComboBox x:Name="WinningFontBox" Height="34" Margin="0,4,0,8" SelectionChanged="DesignChanged"/>
                <WrapPanel>
                    <TextBlock Text="Size (12–80)" VerticalAlignment="Center"/>
                    <TextBox x:Name="WinningSizeBox" Width="65" Margin="8,0" TextChanged="DesignChanged"/>
                    <Button x:Name="WinningColourButton" Content="Message colour" Click="WinningColour_Click"/>
                </WrapPanel>
                <WrapPanel Margin="0,8">
                    <CheckBox x:Name="WinningBoldBox" Content="Bold" Margin="0,0,18,0" Checked="DesignChanged" Unchecked="DesignChanged"/>
                    <CheckBox x:Name="WinningItalicBox" Content="Italic" Checked="DesignChanged" Unchecked="DesignChanged"/>
                </WrapPanel>
                <Separator Margin="0,8,0,14"/>
                <TextBlock Text="Now playing header"/>
                <TextBox x:Name="HeaderBox"
                         Margin="0,4,0,10"
                         Padding="7"
                         TextChanged="DesignChanged"/>

                <TextBlock Text="Ready text"/>
                <TextBox x:Name="ReadyBox"
                         Margin="0,4,0,10"
                         Padding="7"
                         TextChanged="DesignChanged"/>

                <TextBlock Text="Played songs header"/>
                <TextBox x:Name="PlayedHeaderBox"
                         Margin="0,4,0,12"
                         Padding="7"
                         TextChanged="DesignChanged"/>

                <TextBlock Text="Font"/>
                <ComboBox x:Name="FontBox"
                          Margin="0,4,0,12"
                          Height="34"
                          SelectionChanged="DesignChanged"/>

                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,6,8">
                        <TextBlock Text="Header size"/>
                        <TextBox x:Name="HeaderSizeBox"
                                 Padding="6"
                                 TextChanged="DesignChanged"/>
                    </StackPanel>
                    <StackPanel Margin="6,0,0,8">
                        <TextBlock Text="Song title size"/>
                        <TextBox x:Name="TitleSizeBox"
                                 Padding="6"
                                 TextChanged="DesignChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Artist size"/>
                        <TextBox x:Name="ArtistSizeBox"
                                 Padding="6"
                                 TextChanged="DesignChanged"/>
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="Played-list size"/>
                        <TextBox x:Name="PlayedSizeBox"
                                 Padding="6"
                                 TextChanged="DesignChanged"/>
                    </StackPanel>
                </UniformGrid>

                <CheckBox x:Name="ShowArtistBox"
                          Content="Show artist"
                          Checked="DesignChanged"
                          Unchecked="DesignChanged"
                          Margin="0,3,0,8"/>
                <CheckBox x:Name="BoldTitleBox"
                          Content="Bold song title"
                          Checked="DesignChanged"
                          Unchecked="DesignChanged"
                          Margin="0,3,0,8"/>

                <CheckBox x:Name="OutlineTextBox"
                          Content="Use text outline / stroke"
                          Checked="DesignChanged"
                          Unchecked="DesignChanged"
                          Margin="0,3,0,8"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="OutlineColourButton"
                            Grid.Column="0"
                            Content="Outline Colour"
                            Click="OutlineColour_Click"/>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Outline width (px)"/>
                        <TextBox x:Name="OutlineWidthBox"
                                 Margin="0,4,0,0"
                                 Padding="6"
                                 Text="2"
                                 TextChanged="DesignChanged"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="COLOURS"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <UniformGrid Columns="2">
                    <Button x:Name="HeaderColourButton"
                            Content="Header Colour"
                            Click="HeaderColour_Click"/>
                    <Button x:Name="TitleColourButton"
                            Content="Title Colour"
                            Click="TitleColour_Click"/>
                    <Button x:Name="ArtistColourButton"
                            Content="Artist Colour"
                            Click="ArtistColour_Click"/>
                    <Button x:Name="PlayedColourButton"
                            Content="Played Text Colour"
                            Click="PlayedColour_Click"/>
                    <Button x:Name="BackgroundColourButton"
                            Content="Background Colour"
                            Click="BackgroundColour_Click"/>
                </UniformGrid>

                <Separator Margin="0,16,0,14"/>

                <TextBlock Text="BACKGROUND IMAGE"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="BackgroundImageBox"
                         IsReadOnly="True"
                         Height="48"
                         TextWrapping="Wrap"
                         Margin="0,0,0,6"/>

                <WrapPanel>
                    <Button Content="Choose Image..."
                            Click="ChooseBackground_Click"/>
                    <Button Content="Clear Image"
                            Click="ClearBackground_Click"/>
                </WrapPanel>

                <TextBlock Text="Background image opacity"
                           Margin="0,10,0,4"/>
                <Slider x:Name="ImageOpacitySlider"
                        Minimum="0"
                        Maximum="1"
                        ValueChanged="DesignChanged"/>

                <Separator Margin="0,16,0,14"/>

                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Load Design..."
                            Width="120"
                            Click="LoadDesignFile_Click"/>
                    <Button Content="Save As..."
                            Width="110"
                            Click="SaveDesignFile_Click"/>
                    <Button Content="Reset Default"
                            Width="120"
                            Click="Reset_Click"/>
                    <Button Content="Cancel"
                            Width="100"
                            Click="Cancel_Click"/>
                    <Button Content="Use Design"
                            Width="120"
                            FontWeight="Bold"
                            Click="Save_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1"
                Margin="10,18,18,18"
                Background="#D5DAE2"
                CornerRadius="10"
                Padding="22">
            <Viewbox Stretch="Uniform">
                <Border Width="800"
                        Height="450"
                        BorderBrush="#9AA2AF"
                        BorderThickness="1">
                    <Grid x:Name="PreviewRoot" Background="#111722">
                        <Image x:Name="PreviewBackgroundImage"
                               Stretch="UniformToFill"
                               Opacity="0.35"/>

                        <DockPanel Margin="30">
                            <Border DockPanel.Dock="Top" Background="#DD111722" Padding="8" Margin="0,0,0,8">
                                <TextBlock x:Name="PreviewWinning" Text="WE ARE PLAYING FOR A FULL HOUSE" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <controls:OutlinedTextBlock x:Name="PreviewHeader"
                                                        Grid.Row="1"
                                                        Text="NOW PLAYING"
                                                        FontSize="34"
                                                        Foreground="#A8B3C5"
                                                        TextAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,18"/>

                            <StackPanel Grid.Row="2">
                                <controls:OutlinedTextBlock x:Name="PreviewTitle"
                                                            Text="TAKE ON ME"
                                                            Foreground="White"
                                                            FontSize="72"
                                                            FontWeight="Bold"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap"/>
                                <controls:OutlinedTextBlock x:Name="PreviewArtist"
                                                            Text="a-ha"
                                                            Foreground="#D4DCEA"
                                                            FontSize="40"
                                                            TextAlignment="Center"
                                                            Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                        </DockPanel>
                    </Grid>
                </Border>
            </Viewbox>
        </Border>
    </Grid>
</Window>
